{
  "name": "mazinkaiser-ai",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "description": "Repo root — run npm scripts here; app package is in frontend/",
  "scripts": {
    "postinstall": "node scripts/ensure-linux-native-modules.cjs",
    "start": "npm --prefix frontend run dev",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "clean": "npm --prefix frontend run clean",
    "rebuild": "npm --prefix frontend run rebuild",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test",
    "test:perf": "npm --prefix frontend run test:perf",
    "test:backend": "cd backend && python -m pytest -q --tb=short",
    "preview": "npm --prefix frontend run preview",
    "sync:skl-glb": "npm --prefix frontend run sync:skl-glb",
    "inspect:glb": "npm --prefix frontend run inspect:glb"
  }
}
