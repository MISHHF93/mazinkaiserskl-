# Leave empty when the SPA is served behind the same origin that proxies /api and /ws.
# VITE_API_BASE_URL=https://api.your-domain.com

# Mazinkaiser SKL hull: default is the **local** file at /models/mazinkaiser-skl.glb (no env needed).
# Put mazinkaiser_skl.glb at the repo root, or mazinkaiser-skl.glb under frontend/public/models/.
# npm run dev / npm run build runs sync:skl-glb automatically (copies root → public/models/).
# Optional remote override only — direct HTTPS URL to the .glb; must allow CORS from your app origin.
# VITE_KAISER_GLB_URL=https://…/mazinkaiser-skl.glb

# Skip cockpit WebSocket entirely (no reconnect banner). Hull GLB + static UI still load from /models/.
# Useful when Kaiser Core is not running on :8000. Remove or set to 0 to restore uplink.
# VITE_COCKPIT_DISABLE=1

# Optional: Cove SKL move-artifacts JSON (clip aliases, idle names, cue templates, batch metadata).
# Default: /artifacts/mazinkaiser-move-artifacts.cove.json via BASE_URL
# VITE_SKL_ARTIFACTS_URL=https://cdn.example.com/mazinkaiser-move-artifacts.cove.json

# Optional: merged Cove + ``monitor`` overlay (copy from backend emit to public/artifacts).
# Default: /artifacts/mazinkaiser-artifacts.cove.monitor.json
# VITE_SKL_RESONANCE_MONITOR_URL=https://cdn.example.com/mazinkaiser-artifacts.cove.monitor.json
