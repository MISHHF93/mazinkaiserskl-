# Copy to .env — never commit secrets.
ENVIRONMENT=development
DEBUG=false

# CORS for browser dev servers (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional future persistence
# DATABASE_URL=postgresql+asyncpg://mazin:password@localhost:5432/mazinkaiser
# REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible provider (omit key → local stub / classic heuristics-only prompts)
# OPENAI_API_KEY=

# Single inference model ID — UNIFIED_MODEL_ID and OPENAI_MODEL are aliases for the same setting
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# UNIFIED_MODEL_ID=gpt-4o-mini

# When unset: unified single JSON turn (reply + pilot_intent in one completion) auto-enables iff OPENAI_API_KEY is set.
# Set 0 to force the classic two-phase prompt (heuristic intent line in system prompt) even with a key.
# UNIFIED_COGNITIVE_TURN=0

# SKL Cove + GLB dumps for LLM cockpit briefing (`mazinkaiser-move-artifacts.cove.json` + *.inspect/*.nodes.json).
# Omit to resolve `frontend/public/artifacts` relative to Mazinkaiser AI repo root next to `/backend`.
# MAZINKAISER_SKL_ARTIFACTS_DIR=

# Monitored Cove at repo root (``monitor`` block + `artifacts-monitor/resonance_history.jsonl`).
# MAZINKAISER_SKL_MONITOR_COVE_OUTPUT=

# Per-move resonance CSV (heuristic + optional RF); defaults to repo root `mazinkaiser-artifacts-resonance.csv`.
# MAZINKAISER_SKL_RESONANCE_CSV=

# Label for resonance CSV / monitor.identity (generic AI robot publish profile by default).
# AI_ROBOT_ARTIFACT_PROFILE=generic_ai_robot
# MAZINKAISER_ARTIFACT_PROFILE=generic_ai_robot

AUDIT_LOG_PATH=logs/audit.log
ENABLE_STRICT_SAFETY=true

# Prometheus plaintext metrics (/metrics)
EXPOSE_METRICS=false

# Seconds between telemetry ticks on active WebSocket sessions
WS_TELEMETRY_INTERVAL_S=1.2
