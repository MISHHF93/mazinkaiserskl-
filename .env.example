# Copy to `.env` for docker-compose (`env_file: .env`)

# --- Backend (mazinkaiser) ---
ENVIRONMENT=development
DEBUG=false
EXPOSE_METRICS=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional telemetry interval for WebSocket twin ticks (seconds)
WS_TELEMETRY_INTERVAL_S=1.2

# --- Frontend build args (used at `docker compose build`) ---
# Empty string = same-origin relative URLs (nginx proxies `/api` + `/ws`).
VITE_API_BASE_URL=
